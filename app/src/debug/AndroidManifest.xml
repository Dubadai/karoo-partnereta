<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Field gallery: the field at every Karoo size, light and dark (design-assets/tools/field-gallery) -->
        <activity
            android:name=".FieldGalleryActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Start alert at the desk: adb shell am broadcast -a com.daviddokakis.partnereta.DEBUG_ALERT ... (DebugAlertReceiver) -->
        <receiver android:name=".DebugAlertReceiver" android:exported="true">
            <intent-filter><action android:name="com.daviddokakis.partnereta.DEBUG_ALERT" /></intent-filter>
        </receiver>
    </application>
</manifest>
